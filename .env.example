# Mihon fork — local environment configuration
#
# Copy this file to `.env` (gitignored) and fill in the values for your fork.
# Nothing in this repo reads .env automatically; values here are documentation +
# a place to keep your own secrets out of version control.
#
# After editing, the values you actually need to wire into the app are:
#   - the SHA-1 fingerprints below → paste into
#     app/src/firebase/kotlin/eu/kanade/tachiyomi/data/cloudsync/firebase/CloudSyncProductionGuard.kt
#   - the Firebase project credentials → already inside app/google-services.json
#     (download from Firebase console; do NOT commit your fork's file to a public repo)

# ─────────── Firebase project (informational) ───────────
FIREBASE_PROJECT_ID=mobileprogrammingaol-e55be
FIREBASE_PROJECT_NUMBER=89467527216
FIREBASE_REGION=asia-southeast1

# ─────────── Android signing certificates ───────────
# Get with:
#   keytool -list -v -keystore ~/.android/debug.keystore \
#           -alias androiddebugkey -storepass android -keypass android | grep SHA1
DEBUG_KEYSTORE_SHA1=
# Get with:
#   keytool -list -v -keystore <release.jks> -alias <alias> -storepass <pwd> | grep SHA1
RELEASE_KEYSTORE_SHA1=

# ─────────── Package allow-list (for production-app guard) ───────────
ALLOWED_PACKAGE_PRIMARY=app.mihon
ALLOWED_PACKAGE_DEBUG=app.mihon.dev

# ─────────── Cloud sync feature flags ───────────
# These are not consumed by gradle; document your fork's intent here.
CLOUD_SYNC_ENABLED_BY_DEFAULT=false
CLOUD_SYNC_REQUIRE_RECOVERY_EMAIL=false
